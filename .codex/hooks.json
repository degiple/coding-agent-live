{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/block-main-push.sh\"",
            "statusMessage": "mainへのpushを確認しています",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
